{
  "$comment": "Contrato de dados REST (OpenAPI 3.0) da PyCobranca: os schemas JSON que a engine serializa (boleto, fatura, remessa, retorno, encargos, extrato OFX) para consumo por um servico HTTP.",
  "openapi": "3.0",
  "schemas": {
    "BoletoData": {
      "type": "object",
      "required": [
        "nosso_numero",
        "valor",
        "cedente",
        "documento_cedente",
        "sacado",
        "sacado_documento"
      ],
      "properties": {
        "agencia": {
          "type": "string"
        },
        "conta_corrente": {
          "type": "string"
        },
        "nosso_numero": {
          "type": "string"
        },
        "valor": {
          "type": "number"
        },
        "cedente": {
          "type": "string"
        },
        "documento_cedente": {
          "type": "string",
          "pattern": "^(\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}|[0-9A-Za-z]{2}\\.?[0-9A-Za-z]{3}\\.?[0-9A-Za-z]{3}/?[0-9A-Za-z]{4}-?\\d{2})$",
          "description": "CPF (11 digitos) ou CNPJ (14 posicoes). O CNPJ pode ser ALFANUMERICO (IN RFB 2.229/2024): as 12 primeiras posicoes aceitam letras A-Z e os 2 DVs sao numericos. Mascara e opcional."
        },
        "sacado": {
          "type": "string"
        },
        "sacado_documento": {
          "type": "string",
          "pattern": "^(\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}|[0-9A-Za-z]{2}\\.?[0-9A-Za-z]{3}\\.?[0-9A-Za-z]{3}/?[0-9A-Za-z]{4}-?\\d{2})$",
          "description": "CPF (11 digitos) ou CNPJ (14 posicoes). O CNPJ pode ser ALFANUMERICO (IN RFB 2.229/2024): as 12 primeiras posicoes aceitam letras A-Z e os 2 DVs sao numericos. Mascara e opcional."
        },
        "convenio": {
          "type": "string"
        },
        "carteira": {
          "type": "string"
        },
        "data_vencimento": {
          "type": "string"
        },
        "numero_documento": {
          "type": "string"
        },
        "sacado_endereco": {
          "type": "string"
        },
        "data_documento": {
          "type": "string",
          "description": "Data de emissao do titulo (ISO 8601). Obrigatoria no Sicredi, que a usa no ano do nosso numero."
        },
        "digito_conta": {
          "type": "string",
          "description": "DV da conta, quando o banco o exige a parte. Obrigatorio em Unicred, Banco do Nordeste, Banestes e Safra."
        },
        "digito_agencia": {
          "type": "string",
          "description": "DV da agencia. Obrigatorio no Safra."
        },
        "digito_convenio": {
          "type": "string",
          "description": "DV do convenio, usado na impressao pelo Banrisul."
        },
        "variacao": {
          "type": "string",
          "description": "Variacao da carteira (Banestes, Sicoob)."
        },
        "incremento": {
          "type": "string",
          "description": "Incremento de 3 posicoes do campo livre. Obrigatorio no BRB."
        },
        "portfolio": {
          "type": "string",
          "description": "Portfolio de 3 posicoes do campo livre. Citibank."
        },
        "posto": {
          "type": "string",
          "description": "Posto da cooperativa. Sicredi."
        },
        "byte_idt": {
          "type": "string",
          "description": "Byte identificador do nosso numero. Obrigatorio no Sicredi."
        },
        "desconto_abatimento": {
          "type": "number",
          "description": "Faixa FEBRABAN: (-) Desconto / Abatimento. Deduz do valor cobrado. Omitido, o campo sai em branco no boleto - quem preenche e o caixa, no ato do pagamento."
        },
        "outras_deducoes": {
          "type": "number",
          "description": "Faixa FEBRABAN: (-) Outras deducoes. Deduz do valor cobrado."
        },
        "mora_multa": {
          "type": "number",
          "description": "Faixa FEBRABAN: (+) Mora / Multa. Acresce ao valor cobrado."
        },
        "outros_acrescimos": {
          "type": "number",
          "description": "Faixa FEBRABAN: (+) Outros Acrescimos. Acresce ao valor cobrado."
        },
        "valor_cobrado": {
          "type": "number",
          "description": "Faixa FEBRABAN: (=) Valor cobrado. Calculado a partir dos quatro anteriores quando ausente; informado explicitamente, sobrepoe o calculo."
        },
        "instrucao1": {
          "type": "string"
        },
        "instrucao2": {
          "type": "string"
        },
        "emv": {
          "type": "string"
        },
        "pix_label": {
          "type": "string"
        },
        "chave_pix": {
          "type": "string",
          "description": "Chave PIX do recebedor. Monta um BR Code estático: credita a chave, mas NÃO liquida o título no banco. Ignorado quando pix_copia_cola é informado."
        },
        "tipo_chave_pix": {
          "type": "string",
          "enum": [
            "cpf",
            "cnpj",
            "email",
            "telefone",
            "aleatoria"
          ]
        },
        "txid": {
          "type": "string",
          "description": "Identificador da transação (campo 62-05), até 25 caracteres A-Za-z0-9. Vazio, é derivado do nosso número; \"***\" declara ausente.",
          "maxLength": 25
        },
        "pix_copia_cola": {
          "type": "string",
          "description": "Payload EMV devolvido pelo banco ao registrar a cobrança (Bolepix). Vai no QR como veio; tem precedência sobre chave_pix e funciona em qualquer banco. É o QR que liquida o título."
        },
        "pix_observacao": {
          "type": "string",
          "maxLength": 40,
          "description": "Texto livre no campo 26-02 do BR Code, para descrever a cobrança."
        },
        "logo_empresa": {
          "type": "string"
        },
        "cor_marca": {
          "type": "string"
        },
        "marca_dagua": {
          "type": "string"
        },
        "rodape_contato": {
          "type": "string"
        },
        "fonte_ttf": {
          "type": "string"
        },
        "parcela_atual": {
          "type": "integer"
        },
        "total_parcelas": {
          "type": "integer"
        },
        "itens": {
          "type": "array",
          "items": {
            "$ref": "ItemFatura"
          }
        },
        "fatura": {
          "$ref": "FaturaCorpo"
        }
      },
      "$comment": "agencia e conta_corrente NAO sao obrigatorios: o Santander identifica o cedente pelo convenio e a Caixa pelo codigo do beneficiario, sem conta no campo livre. A exigencia por banco e conferida por validar() na engine - ver docs/14-validacao-campos.md."
    },
    "RemessaRequest": {
      "type": "object",
      "required": [
        "empresa_mae",
        "documento_cedente",
        "agencia",
        "conta_corrente",
        "pagamentos"
      ],
      "properties": {
        "empresa_mae": {
          "type": "string"
        },
        "documento_cedente": {
          "type": "string"
        },
        "agencia": {
          "type": "string"
        },
        "conta_corrente": {
          "type": "string"
        },
        "digito_conta": {
          "type": "string"
        },
        "convenio": {
          "type": "string"
        },
        "carteira": {
          "type": "string"
        },
        "variacao_carteira": {
          "type": "string"
        },
        "codigo_beneficiario": {
          "type": "string"
        },
        "sequencial_remessa": {
          "type": "integer"
        },
        "pagamentos": {
          "type": "array",
          "items": {
            "$ref": "Pagamento"
          }
        }
      }
    },
    "Pagamento": {
      "type": "object",
      "required": [
        "nosso_numero",
        "data_vencimento",
        "valor"
      ],
      "properties": {
        "nosso_numero": {
          "type": "string"
        },
        "numero_documento": {
          "type": "string"
        },
        "data_vencimento": {
          "type": "string"
        },
        "valor": {
          "type": "number"
        },
        "nome_sacado": {
          "type": "string"
        },
        "documento_sacado": {
          "type": "string",
          "pattern": "^(\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}|[0-9A-Za-z]{2}\\.?[0-9A-Za-z]{3}\\.?[0-9A-Za-z]{3}/?[0-9A-Za-z]{4}-?\\d{2})$",
          "description": "CPF (11 digitos) ou CNPJ (14 posicoes). O CNPJ pode ser ALFANUMERICO (IN RFB 2.229/2024): as 12 primeiras posicoes aceitam letras A-Z e os 2 DVs sao numericos. Mascara e opcional."
        },
        "endereco_sacado": {
          "type": "string"
        },
        "bairro_sacado": {
          "type": "string"
        },
        "cidade_sacado": {
          "type": "string"
        },
        "uf_sacado": {
          "type": "string"
        },
        "cep_sacado": {
          "type": "string"
        },
        "encargos": {
          "$ref": "Encargos"
        }
      }
    },
    "Encargos": {
      "type": "object",
      "required": [],
      "properties": {
        "mora": {
          "$ref": "Mora"
        },
        "multa": {
          "$ref": "Multa"
        },
        "descontos": {
          "type": "array",
          "items": {
            "$ref": "Desconto"
          }
        },
        "iof": {
          "type": "number"
        },
        "abatimento": {
          "type": "number"
        }
      }
    },
    "Mora": {
      "type": "object",
      "required": [],
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "1",
            "2",
            "3"
          ]
        },
        "valor": {
          "type": "number"
        },
        "percentual": {
          "type": "number"
        },
        "data": {
          "type": "string"
        }
      }
    },
    "Multa": {
      "type": "object",
      "required": [],
      "properties": {
        "codigo": {
          "type": "string"
        },
        "percentual": {
          "type": "number"
        },
        "data": {
          "type": "string"
        }
      }
    },
    "Desconto": {
      "type": "object",
      "required": [],
      "properties": {
        "codigo": {
          "type": "string"
        },
        "valor": {
          "type": "number"
        },
        "data": {
          "type": "string"
        }
      }
    },
    "RetornoItem": {
      "type": "object",
      "required": [],
      "properties": {
        "nosso_numero": {
          "type": "string"
        },
        "numero_documento": {
          "type": "string"
        },
        "data_credito": {
          "type": "string"
        },
        "data_ocorrencia": {
          "type": "string"
        },
        "valor_titulo": {
          "type": "number"
        },
        "valor_pago": {
          "type": "number"
        },
        "valor_tarifa": {
          "type": "number"
        },
        "codigo_ocorrencia": {
          "type": "string"
        },
        "motivo_ocorrencia": {
          "type": "string"
        }
      }
    },
    "ExtratoOFX": {
      "type": "object",
      "required": [
        "banco",
        "conta",
        "transacoes"
      ],
      "properties": {
        "banco": {
          "type": "object"
        },
        "conta": {
          "type": "object"
        },
        "periodo": {
          "type": "object"
        },
        "saldo": {
          "type": "object"
        },
        "transacoes": {
          "type": "array",
          "items": {
            "$ref": "TransacaoOFX"
          }
        },
        "resumo": {
          "type": "object"
        }
      }
    },
    "TransacaoOFX": {
      "type": "object",
      "required": [
        "tipo",
        "valor"
      ],
      "properties": {
        "fitid": {
          "type": "string"
        },
        "tipo": {
          "type": "string",
          "enum": [
            "CREDIT",
            "DEBIT"
          ]
        },
        "data": {
          "type": "string"
        },
        "valor": {
          "type": "number"
        },
        "memo": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "checknum": {
          "type": "string"
        },
        "refnum": {
          "type": "string"
        },
        "nosso_numero_extraido": {
          "type": "string"
        }
      }
    },
    "ItemFatura": {
      "type": "object",
      "required": [],
      "properties": {
        "descricao": {
          "type": "string"
        },
        "quantidade": {
          "type": "number"
        },
        "valor_unitario": {
          "type": "number"
        },
        "valor": {
          "type": "number"
        }
      }
    },
    "FaturaCorpo": {
      "type": "object",
      "required": [],
      "properties": {
        "titulo": {
          "type": "string"
        },
        "blocos": {
          "type": "array",
          "items": {
            "$ref": "BlocoFatura"
          }
        }
      }
    },
    "BlocoFatura": {
      "type": "object",
      "required": [
        "tipo"
      ],
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "tabela",
            "campos",
            "texto",
            "total",
            "separador",
            "espaco"
          ]
        },
        "colunas": {
          "type": "array"
        },
        "linhas": {
          "type": "array"
        },
        "larguras": {
          "type": "array"
        },
        "alinhamento": {
          "type": "string"
        },
        "itens": {
          "type": "array"
        },
        "conteudo": {
          "type": "string"
        },
        "tamanho": {
          "type": "number"
        },
        "rotulo": {
          "type": "string"
        },
        "valor": {
          "type": "number"
        },
        "altura": {
          "type": "number"
        }
      }
    }
  }
}
